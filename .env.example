# ==============================================================================
# STOCKORA ENTERPRISE — ENVIRONMENT VARIABLE TEMPLATE
# ==============================================================================
# This file is the safe, committed template. It lists all required variables
# with placeholder values. Copy to .env and fill in your real values.
#
# NEVER put real secrets in this file — it is committed to version control.
# ==============================================================================

# --- Application Setup ---
PORT=8095
NODE_ENV=development
CORS_ORIGIN=http://localhost:3050
FRONTEND_URL=http://localhost:3050
PUBLIC_FRONTEND_URL=
COOKIE_SECRET=CHANGE_ME_use_a_long_random_string_for_cookie_signing
SECURE_COOKIES=false

# --- Database Connections ---
MONGODB_URI=mongodb://localhost:27017/stockora_mini_database
REDIS_URL=redis://localhost:6379/5

# --- Authentication & Session Keys ---
# Generate a secure random hex: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_replace_with_secure_64_char_random_hex
JWT_REFRESH_SECRET=CHANGE_ME_replace_with_different_secure_64_char_random_hex
JWT_ACCESS_EXPIRATION=30m
JWT_REFRESH_EXPIRATION=7d

# --- Platform Super Admin ---
# If set, a user registering with this email will be granted isPlatformAdmin=true.
# Leave empty to disable the bootstrap super-admin feature.
PLATFORM_ADMIN_EMAIL=

# --- Logging ---
LOG_LEVEL=info

# --- API Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- File Storage & Uploads ---
UPLOAD_MAX_SIZE=5242880
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- Email & OTP Delivery (Brevo / Nodemailer SMTP) ---
# Option A: Brevo Direct HTTPS API (Recommended)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME="Stockora Enterprise"

# Option B: Brevo SMTP Relay / Nodemailer
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login_email
SMTP_PASS=your_brevo_smtp_key
EMAIL_FROM=noreply@yourdomain.com

# --- OTP Verification Security Policy ---
OTP_EXPIRATION_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Payment Gateways ---
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# --- AI Services (Google Gemini) ---
# Production Gemini API key from your paid Google Cloud / AI Studio project
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENABLED=true
# Legacy fallback aliases (supported for backward compatibility):
# AI_SERVICE_API_KEY=your_gemini_api_key_here
# AI_MODEL_NAME=gemini-2.5-flash
