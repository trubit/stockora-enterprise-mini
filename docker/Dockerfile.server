# Multi-stage build for Express Server
FROM node:22-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build:server

FROM node:22-alpine
WORKDIR /app

# Ensure security: set production environment
ENV NODE_ENV=production

# Install curl/wget for health checks if needed (wget is built into alpine busybox)
COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

# Copy compiled backend output
COPY --from=builder /app/dist/server ./dist/server

# Create log and upload directories with correct ownership for the non-root 'node' user
RUN mkdir -p logs uploads public/uploads && chown -R node:node /app

# Run as non-root user
USER node

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:8080/api/v1/health || exit 1

CMD ["node", "dist/server/src/server/index.js"]
